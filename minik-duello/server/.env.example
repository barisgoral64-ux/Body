# development | production | test
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
# Üretimde zorunlu, en az 32 karakter. Geliştirmede varsayılan kullanılır.
JWT_SECRET=
# Cihaz kimliği özeti için AYRI sır (JWT_SECRET ile aynı olamaz). Üretimde zorunlu, en az 32 karakter.
DEVICE_SECRET=
# Yük dengeleyici arkasında true yapın (X-Forwarded-For güvenilir olmalı).
TRUST_PROXY=false
# PostgreSQL bağlantısı. Üretimde zorunlu; geliştirmede boşsa bellek içi depo kullanılır.
DATABASE_URL=
# İstemci güncelleme politikası: asgari sürümün altı zorunlu güncelleme, en yeni sürümün altı isteğe bağlı bildirim.
APP_MIN_VERSION=0.0.0
APP_LATEST_VERSION=0.0.0
# Mağaza adresi (boşsa istemci Google Play adresini paket adından üretir)
APP_UPDATE_URL=
